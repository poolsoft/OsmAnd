<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/car_route_info_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_car_route_info_card"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="7dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView android:id="@+id/car_route_arrival_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#111111" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/car_route_arrival" android:textColor="#666666" android:textSize="11sp" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="34dp" android:layout_marginHorizontal="12dp" android:background="#22000000" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:id="@+id/car_route_remaining_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#111111" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/car_route_remaining" android:textColor="#666666" android:textSize="11sp" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="34dp" android:layout_marginHorizontal="12dp" android:background="#22000000" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:id="@+id/car_route_distance_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#111111" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="@string/car_route_distance" android:textColor="#666666" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
